# SmartDesk — environment configuration
# Copy this file to .env and fill in values. NEVER commit .env or real secrets.

# Flask session signing key.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Path to the SQLite database file used by the running application.
DATABASE_PATH=support.db

# Flask development server
PORT=5000
FLASK_DEBUG=0

# ---------------------------------------------------------------------------
# Microsoft SQL Server — MDB622 coursework artefact ONLY.
# The running Flask application does NOT read these values. See README.
# ---------------------------------------------------------------------------
DB_SERVER=
DB_NAME=SmartDeskDB
DB_USER=
DB_PASSWORD=